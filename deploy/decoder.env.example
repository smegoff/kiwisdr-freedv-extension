FREEDV_SHARED_SECRET=replace-with-64-hex-characters
FREEDV_KIWI_HOST=kiwi.example.lan
FREEDV_KIWI_PORT=8073
FREEDV_KIWI_PASSWORD=
FREEDV_HEALTH_PORT=8074
FREEDV_REPORTER_FREQUENCIES_FILE=/tmp/freedv-reporter-frequencies.json
FREEDV_DASHBOARD_ENABLED=1
FREEDV_DASHBOARD_BIND=0.0.0.0
FREEDV_DASHBOARD_PORT=8076
FREEDV_DASHBOARD_ASSET_DIR=/usr/local/share/freedv-dashboard/current
FREEDV_DASHBOARD_HISTORY_SECONDS=600
FREEDV_DASHBOARD_WATERFALL_FPS=10
# Retains only the latest in-memory post-resampler modem audio. Set to 0 to disable.
FREEDV_DIAGNOSTIC_CAPTURE_SECONDS=60
# Prime decoded speech before returning it at the Kiwi packet cadence. The
# default accommodates the burst spacing observed with RADEV1 while remaining
# below the decoder's fixed 500 ms stale-audio cap.
FREEDV_RETURN_AUDIO_TARGET_MS=280
# Leave disabled until deploy/build-radae.sh and the RADEV1 reference/load
# gates pass. The matching Kiwi Admin switch is a separate required gate.
FREEDV_ENABLE_RADE=0
